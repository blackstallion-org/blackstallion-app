{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://YOUR-STAGING-PROJECT.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "YOUR_STAGING_PUBLISHABLE_KEY"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://YOUR-STAGING-PROJECT.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "YOUR_STAGING_PUBLISHABLE_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://YOUR-STAGING-PROJECT.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "YOUR_STAGING_PUBLISHABLE_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://YOUR-PRODUCTION-PROJECT.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "YOUR_PRODUCTION_PUBLISHABLE_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
